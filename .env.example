# Copy to .env (gitignored) and fill in. Never commit real keys.
# OpenAIClient loads this via multilogue.config.load_dotenv().

OPENAI_API_KEY=

# Optional: skip interactive Access licence prompts in scripts/notebooks
MULTILOGUE_ACCESS_YES=1

# Optional: where public corpora download (default ~/.cache/multilogue)
# MULTILOGUE_DATAPATH=

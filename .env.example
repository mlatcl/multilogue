# Copy to .env (gitignored) and fill in. Never commit real keys.
# resolve_study_client / OpenAIClient load this via multilogue.config.load_dotenv().

OPENAI_API_KEY=

# Optional: skip interactive Access licence prompts in scripts/notebooks
MULTILOGUE_ACCESS_YES=1

# Offline / CI only — required to use FakeClient. Without this flag and
# without OPENAI_API_KEY, resolve_study_client raises (no silent fake).
# MULTILOGUE_FORCE_FAKE=1

# Optional: where public corpora download (default ~/.cache/multilogue)
# MULTILOGUE_DATAPATH=
